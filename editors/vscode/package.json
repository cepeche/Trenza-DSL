{
    "name": "trenza-vsc",
    "displayName": "Trenza DSL",
    "description": "Herramientas de lenguaje para Trenza DSL",
    "version": "1.0.0",
    "publisher": "cepeche",
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:trenza"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "trenza",
                "aliases": [
                    "Trenza",
                    "trenza"
                ],
                "extensions": [
                    ".trz"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Trenza Configuration",
            "properties": {
                "trenza.compilerPath": {
                    "type": "string",
                    "default": "trenza-cli",
                    "description": "Ruta al binario trenza-cli"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "^1.75.0",
        "@typescript-eslint/eslint-plugin": "^5.53.0",
        "@typescript-eslint/parser": "^5.53.0",
        "eslint": "^8.34.0",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0"
    }
}
