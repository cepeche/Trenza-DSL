system SistemaConcurrente:
    initial: ModoNormal
    
    contexts:
        ModoNormal
        ModoAlerta
        ModoEmergencia
    
    concurrent:
        ModoFuego
        ModoAgua

data Recurso:
    id: Id

context ModoNormal:
    input: r: Recurso
    role fuego: Recurso (bind: r)
        on trigger -> ignored
    role agua: Recurso (bind: r)
        on trigger -> ignored
    transitions:
        on alert -> ModoAlerta
        on activateFuego -> ModoFuego
        on activateAgua -> ModoAgua

context ModoAlerta:
    input: r: Recurso
    role fuego: Recurso (bind: r)
        on trigger -> ignored
    role agua: Recurso (bind: r)
        on trigger -> ignored
    transitions:
        on normal -> ModoNormal
        on emerge -> ModoEmergencia

context ModoEmergencia:
    input: r: Recurso
    role fuego: Recurso (bind: r)
        on trigger -> accionCalor()
    role agua: Recurso (bind: r)
        on trigger -> ignored
    transitions:
        on deactivate -> ModoNormal

context ModoFuego:
    input: r: Recurso
    role fuego: Recurso (bind: r)
        on trigger -> accionCalor()
    role agua: Recurso (bind: r)
        on trigger -> ignored
    transitions:
        on deactivate -> ModoNormal

context ModoAgua:
    input: r: Recurso
    role fuego: Recurso (bind: r)
        on trigger -> ignored
    role agua: Recurso (bind: r)
        on trigger -> accionFrio()
    transitions:
        on deactivate -> ModoNormal
