-- external/cronometro_api.trz

-- Declaración de funciones externas (código convencional que el

-- compilador Trenza NO genera, pero cuya firma sí conoce).

-- El compilador genera un trait Rust que el backend debe implementar.

-- Convertido de cronometro_api.trz (6 marzo 2026) a .trz (12 marzo 2026)



external cronometro_api:



    -- Sesiones

    iniciar_sesion(

        tarea_id: ID,

        notas: String?,

        minutos_retroactivos: Int,

        sustituir: Bool

    ) -> Sesion



    obtener_sesion_activa() -> Sesion?



    finalizar_sesion(sesion_id: ID) -> Sesion



    -- Tipos de tarea

    crear_tipo_tarea(

        nombre: String,

        icono: String,

        actividades_permitidas: List<ID>

    ) -> TipoTarea



    editar_tipo_tarea(

        tipo_id: ID,

        nombre: String,

        icono: String

    ) -> TipoTarea



    -- Actividades

    crear_actividad(

        nombre: String,

        color: String,

        permanente: Bool

    ) -> Actividad



    actualizar_actividad(

        ID: ID,

        nombre: String,

        color: String,

        permanente: Bool

    ) -> Actividad



    -- Historial

    cargar_historial(dias: Int) -> List<DiaHistorial>



    -- Diagnóstico

    verificar_conexion() -> EstadoConexion

    cargar_tiempo_acumulado() -> List<ResumenActividad>



    -- Reset

    reset_datos(actividades_conservar: List<ID>) -> Resultado

    descargar_csv() -> Resultado



    -- Utilidades UI

    calcular_tiempo_transcurrido(inicio: Timestamp) -> Int

    actualizar_grid_visible() -> Resultado



    -- PROPUESTA GAP-8: tipos de retorno de error.

    -- Las funciones externas pueden fallar (red, servidor caído, etc.).

    -- El DSL actual no tiene sintaxis para declarar tipos de error

    -- ni para modelar el flujo de error.
