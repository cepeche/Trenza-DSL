-- data.trz — Capa de datos del CronometroPSP

-- Solo estructura. Cero comportamiento.

-- Convertido de data.trz (6 marzo 2026) a .trz (12 marzo 2026)



-- Dominio principal



data TipoTarea:

    tipoId: ID

    nombre: String

    icono: String

    mutable usos7d: Int

    mutable actividades_permitidas: List<ID>



data Tarea:

    tareaId: ID           -- compuesto: "{tipoId}_{actividadId}"

    tipoId: ID

    actividadId: ID

    nombre: String

    icono: String



data Actividad:

    ID: ID

    nombre: String

    color: String

    permanente: Bool



data Sesion:

    sesionId: ID

    tareaId: ID

    inicio: Timestamp

    notas: String?          -- opcional: puede no haber comentario



-- Datos de UI (elementos interactivos como roles)



data CampoTexto:

    ID: ID

    valor: String

    valido: Bool



data CampoNumerico:

    ID: ID

    valor: Int

    minimo: Int



data Boton:

    ID: ID

    etiqueta: String

    mutable habilitado: Bool



data Checkbox:

    ID: ID

    etiqueta: String

    mutable marcado: Bool



data SelectorColor:

    ID: ID

    opciones: List<String>

    mutable seleccionado: String



data SelectorIcono:

    ID: ID

    iconos: List<String>

    mutable seleccionado: String

    mutable filtro: String



data Pestana:

    ID: ID

    etiqueta: String



data ItemMenu:

    ID: ID

    etiqueta: String



-- Datos del historial



data DiaHistorial:

    timestamp: Timestamp

    total: Int           -- segundos totales

    por_actividad: List<ResumenActividad>



data ResumenActividad:

    actividadId: ID

    actividadNombre: String

    actividadColor: String

    tiempo: Int          -- segundos



-- Datos del proceso de reset (3 fases)



data OpcionActividad:

    ID: ID

    nombre: String

    color: String

    permanente: Bool

    conservar: Bool     -- checkbox en fase 2

    mutable marcado: Bool  -- estado UI del checkbox (transient)
