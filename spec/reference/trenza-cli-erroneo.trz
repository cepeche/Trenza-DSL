-- trenza-cli.trz
-- Formal specification of the Trenza CLI Compiler itself.
-- This file defines the internal state machine that orchestrates parsing, validation, and code generation.

date ArgumentosUsuario:
    comando: Texto
    perfil: Texto
    archivoTrz: Texto
    lang: Texto

data AST:
    pares: Lista
    valido: Booleano

data ErrorCompilacion [clasificacion: stderr]:
    linea: Numero
    mensaje: Texto

system CLI_Trenza:
    initial: EsperandoComando

-- FASE 1: Inicialización
context EsperandoComando:
    role terminal: ArgumentosUsuario
        on ejecutar -> leerYEvaluarArgumentos(self.comando, self.archivoTrz)
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    role logger: ErrorCompilacion
        on entrar -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden

    transitions:
        on comandoGenerate -> ParseandoArchivo
        on comandoInvalido -> MostrarAyuda

-- FASE 2: Lexer y Parser (Pest)
context ParseandoArchivo:
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> leerYParsear(self.archivoTrz)
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    role logger: ErrorCompilacion
        on entrar -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden

    transitions:
        on parseoExitoso -> VerificandoReglas
        on errorSintaxis -> ErrorFatal

-- FASE 3: Validación Formal Semántica (Las 6 Reglas)
context VerificandoReglas:
    role validador: AST
        on iniciar_validacion -> comprobarIntegridad(self)
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    role logger: ErrorCompilacion
        on entrar -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden

    transitions:
        on validacionExitosa -> GenerandoStrands
        on validacionFallida -> ErrorFatal

-- FASE 4: Emisión de Código
context GenerandoStrands:
    role generador: AST
        @audit("Generación de Strand 1 (Rust) iniciada internamente")
        on iniciar_generacion_rust -> emitirCodigoRust(self.pares)
        @audit("Generación de Strand 1 (TypeScript) iniciada internamente")
        on iniciar_generacion_ts -> emitirCodigoTS(self.pares)
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role logger: ErrorCompilacion
        on entrar -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden

    transitions:
        on generacionCompleta -> Exito

-- ESTADOS FINALES (Sink states con efectos IO)
context ErrorFatal:
    role logger: ErrorCompilacion
        on entrar -> imprimirErrorFatal(self.mensaje, self.linea)
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden
    transitions:
        on finalizar -> EsperandoComando
        
context Exito:
    role resultado: ArgumentosUsuario
        on entrar -> imprimirMensajeExito(self.archivoTrz)
    role logger: ErrorCompilacion
        on entrar -> forbidden
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    transitions:
        on finalizar -> EsperandoComando

context MostrarAyuda:
    role logger: ErrorCompilacion
        on entrar -> imprimirAyudaCLI
    role terminal: ArgumentosUsuario
        on ejecutar -> forbidden
    role lector_fs: ArgumentosUsuario
        on iniciar_lectura -> forbidden
    role validador: AST
        on iniciar_validacion -> forbidden
    role generador: AST
        on iniciar_generacion_rust -> forbidden
        on iniciar_generacion_ts -> forbidden
    role resultado: ArgumentosUsuario
        on entrar -> forbidden
    transitions:
        on finalizar -> EsperandoComando
