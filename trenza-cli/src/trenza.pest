WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ "--" ~ (!"\n" ~ ANY)* }

program = { SOI ~ definition* ~ EOI }

definition = { data_def | system_def | context_def }

data_def = { "data" ~ ident ~ data_annotation? ~ ":" ~ data_field* }
data_annotation = { "[" ~ ident ~ ":" ~ ident ~ "]" }
data_field = { ident ~ ":" ~ ident }

system_def = { "system" ~ ident ~ ":" ~ "initial:" ~ ident ~ system_sections* }
system_sections = { context_list | concurrent_list | overlay_list | event_list_sec }
context_list = { "contexts:" ~ section_ident* }
concurrent_list = { "concurrent:" ~ section_ident* }
overlay_list = { "overlays:" ~ section_ident* }
event_list_sec = { "events:" ~ event_list }

reserved_section = _{ "contexts:" | "concurrent:" | "overlays:" | "events:" }
section_ident = @{ !reserved_section ~ ident }

event_list = { ident ~ ("," ~ ident)* }

context_def = { "context" ~ ident ~ ":" ~ context_clause* }
context_clause = { role_def | transitions_def | effects_def }

role_def = { "role" ~ ident ~ ":" ~ ident ~ role_action* }
role_action = { decorator? ~ "on" ~ ident ~ ("->" ~ action_call)? }

decorator = { "@" ~ ident ~ "(" ~ string_literal ~ ")" }

action_call = { ident ~ ("(" ~ action_args ~ ")")? }
action_args = { arg ~ ("," ~ arg)* }
arg = { string_literal | ident }

transitions_def = { "transitions:" ~ transition_rule* }
transition_rule = { decorator? ~ "on" ~ ident ~ "->" ~ ident }

effects_def = { "effects:" ~ effect_rule* }
effect_rule = { ident ~ "->" ~ effect_target }
effect_target = { (!"\n" ~ ANY)+ }

ident = @{ (LETTER | "_") ~ (LETTER | ASCII_DIGIT | "_" | ".")* }
string_literal = @{ ("\"" ~ (!"\"" ~ ANY)* ~ "\"") | ("'" ~ (!"'" ~ ANY)* ~ "'") }
