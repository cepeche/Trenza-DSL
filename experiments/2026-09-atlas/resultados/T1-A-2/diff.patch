+// --- MODO PAUSA -----------------------------------------------------------
+function togglePause() {
+    // En modo edición el botón pausa no hace nada
+    if (AppState.modoEdicion) return;
+
+    AppState.pauseMode = !AppState.pauseMode;
+
+    // Clase en <body> para estilos y lógica
+    document.body.classList.toggle('pause-mode', AppState.pauseMode);
+
+    // Indicador visual del botón
