+        on tap -> abrirMenuConfiguracion          -- menú sigue accesible
+    role boton_pausa: Boton
+        on tap -> salirDePausa
+    transitions:
+        on salirDePausa -> ModoNormal
     role tarjeta_tipo: TipoTarea
         on tap -> seleccionarTipoTarea(self.tipoId)
     role tarjeta_tarea: Tarea
