+-- contexts/ModoPausa.trz
+
+-- Modo pausa: se activa y desactiva con el botón ⏸ (boton_pausa).
+
+-- Mientras está activo, no se puede iniciar ninguna tarea, ni entrar en
+
+-- modo edición, ni crear tareas: tarjetas, boton_edicion y boton_nuevo
+
+-- quedan sin efecto. Cambiar de pestaña y abrir el menú de configuración
+
+-- siguen funcionando igual que en ModoNormal.
+
+-- Añadido: 25 septiembre 2026 (tarea "modo pausa").
+
+
+
+context ModoPausa:
+
+
+
+    role tarjeta_tipo: TipoTarea
+
+        on tap -> ignored                          -- en pausa no se puede iniciar tarea
+
+
+
+    role tarjeta_tarea: Tarea
+
+        on tap -> ignored                          -- en pausa no se puede iniciar tarea
+
+
+
+    role pestana_actividad: Actividad
+
+        on tap -> cambiarPestana(self.id)
+
+
+
+    role pestana_frecuentes: Pestana
+
+        on tap -> cambiarPestana('frecuentes')
+
+
+
+    role boton_edicion: Boton
+
+        on tap -> ignored                          -- en pausa no se puede entrar en edición
+
+
+
+    role boton_nuevo: Boton
+
+        on tap -> ignored                          -- en pausa no se pueden crear tareas
+
+
+
+    role boton_configuracion: Boton
+
+        on tap -> abrirMenuConfiguracion
+
+
+
+    role boton_pausa: Boton
+
+        on tap -> salirPausa
+
+
+
+    transitions:
+
+        on salirPausa             -> ModoNormal
+
+        on abrirMenuConfiguracion -> MenuConfiguracion
+
+
+
+    effects:
+
+        cambiarPestana -> actualizarGridVisible()
+
 -- contexts/SesionActiva.trz
 
 -- Contexto CONCURRENTE: coexiste con ModoNormal o ModoEdicion.
