+// === MODO PAUSA ===
+// HTML: #pauseButton ⏸ | CSS: body.pause-mode
+// En modo pausa no se puede iniciar tareas, entrar en modo edición ni crear tareas.
+// Sí se puede cambiar de pestaña y abrir el menú ⚙️. Desde modo edición, ⏸ no hace nada.
+
+function toggleModoPausa() {
+    if (AppState.modoEdicion) return; // en modo edición, el botón ⏸ no hace nada
+    AppState.modoPausa = !AppState.modoPausa;
+    document.getElementById('pauseButton').classList.toggle('active', AppState.modoPausa);
+    document.body.classList.toggle('pause-mode', AppState.modoPausa);
+}
