+// === MODO PAUSA ===
+// HTML: #pauseButton | CSS: body.pause-mode (fondo naranja en área de tareas)
+// En pausa: tarjetas, ✏️ y + no hacen nada. Cambiar de pestaña y ⚙️ siguen funcionando.
+// Tocar ⏸ en modo edición no hace nada.
+
+function togglePausa() {
+    if (AppState.modoEdicion) return; // en modo edición, el botón ⏸ no hace nada
+    AppState.modoPausa = !AppState.modoPausa;
