+// === MODO PAUSA ===
+// HTML: #pauseButton | CSS: body.pause-mode
+// En modo pausa se puede cambiar de pestaña y abrir el menú de settings,
+// pero no se puede iniciar ninguna tarea, entrar en modo edición ni crear tareas.
+// En modo edición, el botón de pausa no hace nada.
+
+function togglePausa() {
+    if (AppState.modoEdicion) return; // en modo edición, el botón de pausa no hace nada
+    AppState.modoPausa = !AppState.modoPausa;
+    document.getElementById('pauseButton').classList.toggle('active', AppState.modoPausa);
+    document.body.classList.toggle('pause-mode', AppState.modoPausa);
+}
